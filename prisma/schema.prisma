// This is your Prisma schema file,
// learn more about it in the docs: [REDACTED-URL]

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ====== Users & Auth ======

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String?

  // RBAC
  role String @default("user") // "user" | "superadmin"

  // Account status: active | suspended | banned
  status String @default("active")

  // Email verification
  emailVerified   DateTime?
  verifyToken     String?   @unique
  verifyExpiresAt DateTime?

  // Relations
  apiKeys        ApiKey[]
  wallet         Wallet?
  subscriptions  Subscription[]
  packages       UserPackage[]
  usageRecords   UsageRecord[]
  billingRecords BillingRecord[]
  conversations  Conversation[]
  notifications  Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ====== Conversations ======

model Conversation {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String
  model    String
  messages Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

// ====== API Keys ======

model ApiKey {
  id     String  @id @default(cuid())
  key    String  @unique
  name   String
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  isActive    Boolean   @default(true)
  usageCount  Int       @default(0)
  totalTokens Int       @default(0)
  lastUsed    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

// ====== Wallet ======

model Wallet {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  balance   Decimal @default(0) // IDR
  updatedAt DateTime @updatedAt
}

// ====== Plans ======

model Plan {
  id            String @id @default(cuid())
  name          String
  description   String?
  billingPeriod String // "daily" | "weekly" | "monthly" | "yearly"
  price         Decimal // IDR

  // Quota limits
  maxTokensPerPeriod Int

  // Access control
  allowedModels    String[] // empty = none (used when allModels = false)
  allModels        Boolean  @default(true) // true = semua model diizinkan, false = wajib isi allowedModels
  allowedProviders String[] // empty = none (used when allProviders = false)
  allProviders     Boolean  @default(true) // true = semua provider diizinkan, false = wajib isi allowedProviders
  streaming        Boolean  @default(true)
  imageGeneration  Boolean  @default(false)
  apiAccess        Boolean  @default(true)
  priority         String   @default("normal") // low | normal | high

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  subscriptions Subscription[]
  packages      UserPackage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ====== Subscriptions ======

model Subscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  status     String   @default("active") // active | expired | cancelled
  tokensUsed Int      @default(0)
  startDate  DateTime @default(now())
  endDate    DateTime
  autoRenew  Boolean  @default(false)

  createdAt DateTime @default(now())
}

// ====== User Packages ======

model UserPackage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  status          String   @default("active") // active | expired | depleted
  tokensRemaining Int
  tokensTotal     Int
  expiresAt       DateTime

  billingId String?

  createdAt DateTime @default(now())
}

// ====== Usage Records ======

model UsageRecord {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  model    String
  provider String?
  source   String // "puter" | "aggregator"

  promptTokens     Int @default(0)
  completionTokens Int @default(0)
  totalTokens      Int @default(0)

  cost     Decimal?
  endpoint String

  createdAt DateTime @default(now())
}

// ====== Billing Records ======

model BillingRecord {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   String // "topup" | "package_purchase" | "subscription"
  amount Decimal // IDR
  status String  @default("pending") // pending | paid | failed | expired

  midtransOrderId String? @unique
  midtransToken   String?
  midtransUrl     String?

  planId      String?
  description String?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
}

// ====== Notifications ======

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String // "usage_alert" | "subscription_expiry" | "low_balance" | "system"
  title   String
  message String
  read    Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

// ====== App Models (sold in app) ======

model AppModel {
  id        String @id @default(cuid())
  modelId   String @unique
  name      String
  provider  String
  providerModelId String?

  // Pricing — cost to us
  costPer1kPrompt     Decimal?
  costPer1kCompletion Decimal?
  markupPercent       Decimal  @default(0)

  // PAYG price (default, higher)
  sellPricePer1kPrompt     Decimal?
  sellPricePer1kCompletion Decimal?

  // Token Plan price (discounted, used when client has active UserPackage)
  tokenPlanPricePer1kPrompt     Decimal?
  tokenPlanPricePer1kCompletion Decimal?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ====== Aggregator Config ======

model AggregatorConfig {
  id        String  @id @default(cuid())
  name      String
  baseUrl   String
  apiKeyEnc String // encrypted
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ====== Payment Gateway Config ======

model PaymentGatewayConfig {
  id           String  @id @default(cuid())
  provider     String  @default("midtrans") // "midtrans" | "xendit"
  name         String
  serverKeyEnc String
  clientKeyEnc String
  environment  String  @default("sandbox") // sandbox | production
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
